# Dimitris Pens — environment variables. Copy to .env for local dev, or
# better: run `npm run setup` which generates real secrets for you.
# On Vercel, set these in Project → Settings → Environment Variables
# (separate values for Production and Preview). Never commit real values.

# Postgres connection string (Vercel/Neon integration injects POSTGRES_URL).
POSTGRES_URL=postgres://postgres:penstest@localhost:5432/postgres

# Admin password hash — generate with `npm run hash-password`. Not the password itself.
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...$...

# 32-byte AES-256-GCM key for customer PII, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key = losing access to encrypted customer data. Back it up.
PII_ENC_KEY=

# Key rotation: put the OLD key(s) here (comma-separated) and a new
# PII_ENC_KEY above; rows are re-encrypted with the new key on next boot.
# PII_ENC_KEYS_PREVIOUS=

# Local http only: let the admin cookie work without HTTPS. Leave unset in production.
# COOKIE_SECURE=false

# PGSSL=true            # force TLS to Postgres (auto for neon.tech / vercel-storage.com)
# PORT=3001
# ALERT_TO=orders@example.com   # initial shipping-alert recipient (editable in admin settings)

# Shipping-alert emails via Resend (optional — without a key, alerts stay
# queued in the admin Outbox). onboarding@resend.dev can only send to your
# own Resend account email until you verify a domain.
# RESEND_API_KEY=re_...
# RESEND_FROM=Dimitris Pens <orders@yourdomain.com>

# Daily cleanup job (GET /api/cron/cleanup, scheduled in vercel.json). Vercel
# Cron sends "Authorization: Bearer $CRON_SECRET". Unset = endpoint disabled.
# CRON_SECRET=

# Admin feedback (#40): each item an admin sends opens a GitHub issue.
# A fine-grained token limited to the repo below, with Issues read/write.
# Without it, feedback is saved and can be sent later from the panel.
# GITHUB_TOKEN=github_pat_...
# FEEDBACK_REPO=FullStackKevinVanDriel/dimitris-pens   # default; issues are public on a public repo
