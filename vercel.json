{
  "git": {
    "deploymentEnabled": false
  },
  "outputDirectory": "server/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "migrations/*.sql"
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "30 9 * * *"
    }
  ]
}
